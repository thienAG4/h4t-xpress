# Copy to .env:  cp .env.example .env
# Values below are for local development only. Never reuse them in production.

# ---- Database (docker compose builds DATABASE_URL for the api service from these) ----
POSTGRES_USER=h4t
POSTGRES_PASSWORD=h4t_dev_password
POSTGRES_DB=h4t

# Used only when running the API outside Docker (uv run ...).
# Neon/managed Postgres URLs (postgresql://...?sslmode=require) are normalised automatically.
DATABASE_URL=postgresql+asyncpg://h4t:h4t_dev_password@localhost:5432/h4t

# ---- App ----
APP_ENV=local
DEMO_MODE=true
DEMO_PASSWORD=Demo@12345
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
FILE_STORAGE=local
UPLOAD_DIR=uploads

# ---- ShopNow (simulated e-commerce partner) ----
SHOPNOW_API_KEY=shopnow-demo-key
SHOPNOW_WEBHOOK_SECRET=shopnow-demo-webhook-secret
SHOPNOW_WEBHOOK_URL=http://localhost:8000/api/v1/sim/shopnow/webhooks

# ---- Seed ----
SEED_HISTORY_DAYS=90
SEED_RANDOM_SEED=11

# ---- Web ----
WEB_PORT=8080
